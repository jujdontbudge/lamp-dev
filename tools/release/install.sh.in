#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Lamp @VERSION@: curl -fsSL @BASE@/install.sh | sh
# Signature + built-in archive digest. No interactive privilege prompts.
# LAMP_PREFIX (default ~/.local/lamp), LAMP_SERVICE, LAMP_STORE_GIB (default 80).
set -eu
VERSION=@VERSION@
BASE=@BASE@
TRUST='@TRUST@'
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) PLAT=linux-amd64; SHA=@SHA_linux-amd64@; ENGINE=@ENGINE_linux-amd64@; SVC=systemd ;;
  Linux/aarch64) PLAT=linux-arm64; SHA=@SHA_linux-arm64@; ENGINE=@ENGINE_linux-arm64@; SVC=systemd ;;
  Darwin/arm64) PLAT=darwin-arm64; SHA=@SHA_darwin-arm64@; ENGINE=@ENGINE_darwin-arm64@; SVC=launchd ;;
  *) echo "lamp: no $VERSION build for $(uname -s)/$(uname -m)" >&2; exit 1 ;;
esac
PREFIX=${LAMP_PREFIX:-$HOME/.local/lamp}
[ "$ENGINE" = yes ] || { echo 'lamp: this archive has no sandbox engine; refusing a control-only install' >&2; exit 1; }
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$work"
echo "Downloading Lamp $VERSION and its default Linux seed…"
curl -fsSL -o lamp.tar.gz "$BASE/lamp-$VERSION-$PLAT.tar.gz"
if command -v sha256sum >/dev/null; then got=$(sha256sum lamp.tar.gz | cut -d' ' -f1); else got=$(shasum -a 256 lamp.tar.gz | cut -d' ' -f1); fi
[ "$got" = "$SHA" ] || { echo 'lamp: archive digest mismatch; refusing to install' >&2; exit 1; }
tar -xzf lamp.tar.gz
printf '%s\n' "$TRUST" > release-trust.pub
if ! "lamp-$VERSION/$PLAT/payload/bin/lamp-installer" install --release "lamp-$VERSION" \
  --trust release-trust.pub --prefix "$PREFIX" --service "${LAMP_SERVICE:-$SVC}" \
  --engine --store-gib "${LAMP_STORE_GIB:-80}"; then
  echo 'lamp: installation failed; see the error above. No sandbox is ready.' >&2
  exit 1
fi
echo "Lamp $VERSION ready. Binaries: $PREFIX/current/bin"
echo "Owner credential (private; clients load it automatically): $PREFIX/config/owner.token"
printf 'For this shell and your shell profile: export PATH="%s/current/bin:$PATH"\n' "$PREFIX"
printf 'Run code: %s/current/bin/lamp sandbox run -- uname -a\n' "$PREFIX"
printf 'Installation and engine setup: https://gitlab.com/johansardar/lamp/-/blob/v%s/docs/install.md#engine-setup\n' "$VERSION"
printf 'Update, rollback and uninstall: https://gitlab.com/johansardar/lamp/-/blob/v%s/docs/install.md#update-rollback-and-remove-an-install\n' "$VERSION"
